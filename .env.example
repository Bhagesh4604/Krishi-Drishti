# =============================================================================
# Krishi-Drishti – Environment Variable Reference
# =============================================================================
# Copy this file to .env (root) and/or backend/.env and fill in real values.
# NEVER commit the actual .env files – they are already in .gitignore.
# =============================================================================

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# Application environment. Set to "production" on Render/cloud deployments.
# When APP_ENV=production, a missing/default SECRET_KEY causes an immediate startup failure.
APP_ENV=development

# JWT access-token lifetime in minutes. Default: 60.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI / ML ───────────────────────────────────────────────────────────────────
# Your Google Gemini API Key for AI features (crop diagnosis, chat, SOC insights).
GEMINI_API_KEY=your_gemini_api_key_here

# Use the bundled local disease model instead of Gemini Vision (saves API quota).
# Values: "true" | "false" | "auto" (default – uses local model if files are present)
USE_LOCAL_DISEASE_MODEL=auto

# ── SMS / OTP ─────────────────────────────────────────────────────────────────
# Leave SMS_PROVIDER unset for development (OTP prints to server console only).
# Supported values: twilio | msg91 | fast2sms
# SMS_PROVIDER=twilio

# Twilio credentials (required when SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# MSG91 credentials (required when SMS_PROVIDER=msg91)
# MSG91_AUTH_KEY=your_auth_key
# MSG91_SENDER_ID=KRISHD

# ── Database ──────────────────────────────────────────────────────────────────
# Optional PostgreSQL URL. If unset, SQLite is used (development only).
# WARNING: SQLite on Render's ephemeral disk loses data on each redeploy.
# DATABASE_URL=postgresql://user:password@localhost/krishi_drishti

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Use "*" only for local dev.
# Example: CORS_ORIGINS=https://app.krishidrishti.com,https://admin.krishidrishti.com
CORS_ORIGINS=*

# ── Google Earth Engine ───────────────────────────────────────────────────────
# Service-account credentials for GEE satellite features.
# If not configured, satellite spectral data is explicitly marked unavailable.
# EE_SERVICE_ACCOUNT=my-service-account@my-project.iam.gserviceaccount.com
# EE_PRIVATE_KEY_PATH=/path/to/private-key.json

# ── Celery / Redis (optional) ─────────────────────────────────────────────────
# If not set, Celery falls back to eager (synchronous) execution.
REDIS_URL=redis://localhost:6379/0

# ── Cloudinary (optional – evidence photo upload) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=/api
