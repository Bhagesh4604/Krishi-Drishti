# --- Backend Configuration ---
# Your Google Gemini API Key for AI features
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: PostgreSQL Database URL. If not set, SQLite is used.
# DATABASE_URL=postgresql://user:password@localhost/krishi_drishti

# Redis URL for Celery Tasks. If empty, the app falls back to eager execution.
REDIS_URL=redis://localhost:6379/0

# Optional: Cloudinary config for uploading evidence photos
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Frontend Configuration ---
# Note: Vite uses .env.local, but for production build you might set these in CI/CD
VITE_API_URL=/api
VITE_GEMINI_API_KEY=your_gemini_api_key_here
